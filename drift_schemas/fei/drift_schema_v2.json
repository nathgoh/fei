    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"group_id\" TEXT NOT NULL REFERENCES category_groups (id), \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"emoji\" TEXT NOT NULL DEFAULT '🏷️', \"color\" INTEGER NOT NULL DEFAULT 4287137928, \"is_fixed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_fixed\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recurring_series",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_series\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"kind\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES categories (id), \"merchant\" TEXT NULL, \"notes\" TEXT NULL, \"frequency\" TEXT NOT NULL, \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NULL, \"generated_through\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
