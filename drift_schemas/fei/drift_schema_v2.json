      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"kind\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"date\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES categories (id), \"merchant\" TEXT NULL, \"notes\" TEXT NULL, \"recurring_id\" TEXT NULL REFERENCES recurring_series (id), PRIMARY KEY (\"id\"));"
        }
      ]
